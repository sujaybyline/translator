PORT=4010
NODE_ENV=development

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:5173

# Google Gemini API (required for translation)
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Translation batching
TRANSLATION_BATCH_SIZE=25
TRANSLATION_MAX_RETRIES=3

# File limits (bytes) — default 10 MB
MAX_FILE_SIZE=10485760

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xliff_translator

# Optional single URL (overrides individual DB_* if set)
# DATABASE_URL=mysql://root@localhost:3306/xliff_translator
