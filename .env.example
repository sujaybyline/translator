# Backend environment configuration
# This file should be placed in backend/.env

PORT=4010
NODE_ENV=development

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:5173

# Storage directories (absolute paths recommended on VPS)
UPLOAD_DIR=/var/data/xliff-translator/uploads
OUTPUT_DIR=/var/data/xliff-translator/output
BACKUP_DIR=/var/data/xliff-translator/backup

# AI provider credentials are configured in Settings (stored in MySQL).
# Optional legacy defaults only — not used when DB settings exist.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Translation batching
TRANSLATION_BATCH_SIZE=25
TRANSLATION_BATCH_DELAY_MS=2500
TRANSLATION_MAX_RETRIES=3

# File limits (bytes) — default 10 MB
MAX_FILE_SIZE=10485760

# MySQL (required for settings persistence and translation history)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xliff_translator

# Optional single URL (overrides individual DB_* if set)
# DATABASE_URL=mysql://root@localhost:3306/xliff_translator
